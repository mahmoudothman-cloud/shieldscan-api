# Copy to .env for local dev. Never commit .env.
DATABASE_URL=postgresql+asyncpg://shieldscan:REPLACE_PG_PASSWORD@localhost:5432/shieldscan
# Redis requires a password (docker-compose.dev.yml passes --requirepass).
# Note the EMPTY username and the leading colon: redis://:<password>@host
# Prefer a long hex password (openssl rand -hex 32) — no percent-encoding.
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@localhost:6379/0
QDRANT_URL=http://localhost:6333

ANTHROPIC_API_KEY=sk-ant-REPLACE
OPENAI_API_KEY=sk-REPLACE
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

R2_ACCOUNT_ID=REPLACE
R2_ACCESS_KEY=REPLACE
R2_SECRET_KEY=REPLACE
R2_BUCKET=shieldscan-dev

JWT_SECRET_KEY=dev-change-me-min-32-bytes-xxxxxxxxxxxxxxxx
FERNET_KEY=generate-with-Fernet.generate_key()

ENVIRONMENT=development

# --- docker-compose.dev.yml interpolation (not read by the app) ---
# Must match the passwords embedded in the URLs above.
POSTGRES_PASSWORD=REPLACE_PG_PASSWORD
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
